; Crawl Brawl Beta 0.1 Save Portability & Distribution Hardening
; Edit through the Godot UI where possible after initial scaffolding.
config_version=5

[application]

config/name="Crawl Brawl"
config/description="Dig the bunker. Hold the Core. Survive the swarm."
config/version="0.1.0-beta.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="Crawl Brawl"
run/main_scene="res://scenes/main.tscn"

[display]

[display/window]

size/viewport_width=640
size/viewport_height=360
size/window_width_override=1280
size/window_height_override=720
size/resizable=true
stretch/mode="canvas_items"
stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.070588, 0.094118, 0.12549, 1)
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[gui]

theme/custom_font="res://assets/fonts/ShareTechMono-Regular.ttf"

[debug]

gdscript/warnings/inference_on_variant=0
