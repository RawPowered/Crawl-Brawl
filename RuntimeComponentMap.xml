<?xml version="1.0" encoding="UTF-8"?>
<runtime_components schema="1" source="scripts/phase0_run.gd" phase="1">
  <invariants>
    <invariant id="run_facade">CrawlBrawlRun remains the scene-facing composition root and compatibility facade.</invariant>
    <invariant id="save_schema">SAVE_VERSION and RealmSave schema remain unchanged in Phase 1.</invariant>
    <invariant id="state_authority">Authoritative mutable run state remains on CrawlBrawlRun until explicit state migration.</invariant>
    <invariant id="external_systems">Existing systems/* scripts keep their current paths and APIs.</invariant>
    <invariant id="structural_only">Phase 1 intentionally changes ownership structure, not gameplay behavior.</invariant>
  </invariants>

  <component id="run_host" status="active" path="scripts/phase0_run.gd" role="composition_root">
    <owns>Godot lifecycle callbacks, scene integration, authoritative Phase-1 state, compatibility method facade</owns>
  </component>

  <component id="world_presentation" status="extracted" phase="1" path="systems/run_components/run_world_presentation.gd" functions="105">
    <owns>terrain/world drawing, material tiling, visual props/formations/landmarks, minimap raster/cache helpers</owns>
    <depends_on>run_host,world_grid,realm_visual_style,base_network,placeable_blocks</depends_on>
  </component>

  <component id="actor_presentation" status="extracted" phase="1" path="systems/run_components/run_actor_presentation.gd" functions="46">
    <owns>structures,enemies,brood nests,projectile visuals,player/held-weapon visuals,mining/target/build previews</owns>
    <depends_on>run_host,combat_vfx,biome_bestiary,base_network,foundry,personal_base,operator_loadout</depends_on>
  </component>

  <component id="hud_presentation" status="extracted" phase="1" path="systems/run_components/run_hud_presentation.gd" functions="21">
