    <depends_on>scrap_economy,upgrade_economy,progression_tree,player_armor,foundry,structure_runtime</depends_on>
  </component>
  <component id="persistence_runtime" status="planned" phase="8">
    <owns>checkpoint slots,realm serialization,load/migration,recovery cache</owns>
    <depends_on>realm_save,all_runtime_state_contracts</depends_on>
  </component>
  <component id="overlay_ui" status="planned" phase="9">
