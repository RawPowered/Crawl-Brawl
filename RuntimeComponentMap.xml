    <depends_on>run_host,expedition_hud,realm_visual_style,display_settings,base_network</depends_on>
  </component>

  <component id="world_runtime" status="planned" phase="2">
    <owns>stream/preload scheduling,render-window decisions,exploration/discovery,terrain dirty scheduling</owns>
    <depends_on>world_grid,world_load,flow_field,run_host</depends_on>
  </component>
  <component id="operator_runtime" status="planned" phase="3">
