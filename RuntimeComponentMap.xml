    <depends_on>operator_loadout,operator_onboard,placeable_blocks,world_runtime</depends_on>
  </component>
  <component id="encounter_runtime" status="planned" phase="4">
    <owns>scouts,hive awareness,wave delivery,spawn admission,brood nests,enemy routing and locomotion</owns>
    <depends_on>hive_awareness,wave_spawn,mob_locomotion,flow_field,world_runtime</depends_on>
  </component>
  <component id="combat_runtime" status="planned" phase="5">
